{
  "name": "vps-cockpit",
  "version": "0.3.5",
  "description": "Pilote ton VPS en un clic, sans taper de commande SSH",
  "main": "main.js",
  "author": "VPS Cockpit",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable --x64"
  },
  "dependencies": {
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.vps.cockpit",
    "productName": "VPS Cockpit",
    "files": [
      "main.js",
      "preload.js",
      "remote.js",
      "renderer/**/*",
      "package.json",
      "updater.js"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "VPS-Cockpit.exe"
    },
    "directories": {
      "output": "dist"
    }
  },
  "cockpit": {
    "updateRepo": "karimbel/VPS-Cockpit"
  }
}